{
  "manifest_version": 3,
  "name": "Bookmark Homepage",
  "version": "1.1.0",
  "description": "Replaces the New Tab page with your bookmarks: grid and folder views, drag-and-drop organizing, personal notes, and a custom CSS theme.",
  "permissions": [
    "bookmarks",
    "storage",
    "search"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bookmark-homepage@extension",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
