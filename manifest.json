{
  "manifest_version": 3,
  "name": "Bookmark Homepage",
  "version": "2.0.0",
  "description": "A calm start page with a photo, clock, search and your most visited sites, plus your bookmarks one swipe away: grid and folder views, notes and custom CSS.",
  "permissions": [
    "bookmarks",
    "storage",
    "search",
    "topSites",
    "favicon"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bookmark-homepage@extension",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
