{
  "manifest_version": 3,
  "name": "Vesper",
  "version": "2.0.0",
  "description": "A calm start page with a photo, clock, search and your most visited sites, plus your bookmarks one swipe away: grid and folder views, notes and custom CSS.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "bookmarks",
    "storage",
    "search",
    "topSites",
    "favicon"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vesper@extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
